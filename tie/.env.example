TIE_HTTP_PORT=8080
TIE_GRPC_PORT=50051
TIE_POLICY_MODE=critical-fail-closed
TIE_ENABLE_GRPC=false
TIE_CACHE_TTL_SECS=300
TIE_VALIDATION_CACHE_TTL_SECS=60
TIE_VERIFIER_BUDGET_MS=175
TIE_REQUIRE_FACT_CITATIONS=true
TIE_REQUIRE_ACTION_APPROVAL=true
RUST_LOG=info
# 64-byte Ed25519 secret key hex if registry record signing is enabled
TIE_SIGNING_KEY_HEX=
